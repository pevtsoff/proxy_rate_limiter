# Copy to .env (run.sh does it for you). Used by docker compose and by the apps.
POSTGRES_USER=proxy
POSTGRES_PASSWORD=proxy-dev-password
POSTGRES_DB=proxy
POSTGRES_TEST_DB=proxy_test

# Host ports
PROXY_PORT=8000
TARGET_API_PORT=8001
POSTGRES_PORT=5432
REDIS_PORT=6379
LOCUST_PORT=8089

# Number of uvicorn workers (= proxy instances sharing Redis)
PROXY_WORKERS=2

# Bearer tokens (HS256 JWT, `sub` = consumer id). Change for anything but local dev.
JWT_SECRET=dev-only-secret-change-me-0123456789abcdef
JWT_ALGORITHM=HS256
JWT_DEFAULT_TTL_SECONDS=86400

# MUC5: LRU policy cache
LRU_CACHE_CAPACITY=1000
LRU_CACHE_TTL=3600

# MUC3: default policy, pre-created on startup
DEFAULT_POLICY_NAME=default
DEFAULT_POLICY_STRATEGY=moving-window
DEFAULT_POLICY_REQUESTS=60
DEFAULT_POLICY_PERIOD=minute

# slowapi limit of the management API, per client IP
ADMIN_RATE_LIMIT=1000/minute
ADMIN_RATE_LIMIT_ENABLED=true

TARGET_OPENAPI_PATH=/openapi.json
UPSTREAM_TIMEOUT_SECONDS=10
LOG_LEVEL=INFO
