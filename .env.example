# Copy to .env (run.sh does this automatically) and adjust. All values are used by
# src/main/docker/docker-compose.yml.
# Ports published on the host
PROXY_PORT=8000
PROXY_REPLICA_PORT=8002
TARGET_API_PORT=8001
POSTGRES_PORT=5432
REDIS_PORT=6379
LOCUST_PORT=8089

# Suffix added to every container name in the compose stack, e.g.
# proxy-rate-limiter-redis-java-1
DOCKER_TAG=java

# PostgreSQL (configuration database of the proxy)
POSTGRES_USER=proxy
POSTGRES_PASSWORD=change-me
POSTGRES_DB=proxy

# Consumer bearer tokens: HS256, secret must be at least 32 bytes
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-bytes
JWT_DEFAULT_TTL_SECONDS=86400

# Admin login for /admin/api (HTTP Basic) and the admin UI at /ui (form login)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# MUC5: LRU cache of (consumer_id, method, rest_path) -> applicable policy
LRU_CACHE_CAPACITY=1000
LRU_CACHE_TTL=3600

# MUC3: default policy created by the first database migration
DEFAULT_POLICY_NAME=default
DEFAULT_POLICY_STRATEGY=moving-window
DEFAULT_POLICY_REQUESTS=60
DEFAULT_POLICY_PERIOD=minute

# Target API
TARGET_OPENAPI_PATH=/v3/api-docs
UPSTREAM_TIMEOUT_SECONDS=10
RESOURCE_SYNC_ON_STARTUP=true

LOG_LEVEL=INFO
