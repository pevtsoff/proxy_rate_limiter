<?xml version="1.0" encoding="UTF-8"?>
<!-- Every line carries class, method and line number; exceptions are logged with their full
     stack trace (requirement: "Proxy Limiter Details" 2 and 3). -->
<configuration>
    <property name="PATTERN"
              value="%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} %-5level [%thread] %class{40}.%method:%line - %msg%n%xException{full}"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${PATTERN}</pattern>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
